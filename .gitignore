.claude/

# Build directories
build/
cmake-build-*/

# tests/roms-src (SH-3b): upstream clones-at-SHA are refetched by build.py,
# never committed; versions.json is regenerated from the toolchain image by
# tools/rom-toolchain/build-image.sh. rom_manifest.json IS committed (it's the
# reproducibility ledger build.py writes and the harness reads back).
tests/roms-src/*/*/upstream/
tools/rom-toolchain/versions.json
out/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Compiled binaries
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
# ...except a devkitARM ROM recipe's own committed build Makefile
# (tests/roms-src/gba/veloce_smoke_devkitarm/, future nba-hw-test patches):
# that's source, not a CMake-generated artifact.
!tests/roms-src/**/Makefile

# Visual Studio
*.sln
*.vcxproj*
*.user
*.suo
*.ncb
*.opensdf
*.sdf
x64/
x86/
Debug/
Release/
.vs/

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/

# User data (config, saves, etc.)
config/
splits/
saves/
savestates/
screenshots/
artifacts/
*.sav
*.tas
*.fm2

# Test ROMs (don't commit copyrighted ROMs)
*.nes
*.sfc
*.smc
*.gb
*.gbc
*.gba
*-test-roms/
mgba-suite/
nba-hw-test/
alyosha-gba-tests/
armwrestler/
fuzzarm/

# devkitARM/toolchain build artifacts under tests/roms-src (never commit
# built ROMs or their intermediates -- sources/patches/manifests only).
*.elf
*.map
tests/roms-src/*/*/upstream/

# Logs
*.log

# Package managers
vcpkg_installed/
_deps/

# Temporary files
*.tmp
*.temp

# Python bytecode
__pycache__/
*.pyc

# stray headless-run screenshots in repo root
/screenshot_frame_*.png
/screenshot_final.png
