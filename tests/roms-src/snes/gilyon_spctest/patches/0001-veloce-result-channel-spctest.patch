--- a/spctest/make_tests.py
+++ b/spctest/make_tests.py
@@ -6,6 +6,10 @@ test_num = 0
 file_num = 0
 tests_txt = []
 spc_code = []
+# Veloce VELOCE-RESULT/1 patch: one expected-value record per test for the
+# S-CPU side (see write_veloce_expected()). The S-SMP only hands back P/A/X/Y
+# when a test fails, so those are the values the S-CPU can compare.
+veloce_records = []
 
 FLAGS_MAP = {'C': 1, 'Z': 2, 'I': 4, 'H': 8, 'B': 0x10, 'P': 0x20, 'V': 0x40, 'N': 0x80}
 
@@ -140,6 +144,10 @@ def test(ins, a=0x12, x=0x34, y=0x56, p=None, ea=None, ex=None, ey=None, ep=None
     .next_test:
     ''')
 
+    veloce_records.append(dict(
+        name=veloce_check_name(ins), ep=ep, ea=ea, ex=ex, ey=ey,
+        flags=(1 if esp is not None else 0) | (2 if any(v is not None for v in mem_output.values()) else 0) |
+              (0x80 if (before_regs or before_ins or after_ins or after_checks) else 0)))
     tests_txt.append(f'Test {test_num:04x}: {ins}')
     inputs = f'A=${a:02x} X=${x:02x} Y=${y:02x} P=${p:02x}'
     if mem_input:
@@ -935,6 +943,32 @@ def start_spc_file():
     spc_code.append('start_tests:\n')
 
 
+def veloce_check_name(ins):
+    """CHECK-line name for a test: the instruction text with whitespace
+    collapsed (VELOCE-RESULT/1 names end at the first key=value token, so a
+    name must never contain '=')."""
+    name = ' '.join(ins.split(';', 1)[0].split())
+    assert '=' not in name and '"' not in name, name
+    return name
+
+
+def write_veloce_expected():
+    """spc_expected.inc (ca65, S-CPU side): VT_TOTAL_TESTS, a 16-bit pointer
+    table vt_exp_ptrs and one record per test, all in the unused BANK3.
+    Record: flags (bit0 SP checked, bit1 memory checked, bit7 extra
+    hand-written setup/checks), expected P, A, X, Y, NUL-terminated name."""
+    lines = ['; Auto-generated by make_tests.py (Veloce VELOCE-RESULT/1 patch)',
+             f'VT_TOTAL_TESTS = {len(veloce_records)}', '',
+             '.segment "BANK3"', 'vt_exp_ptrs:']
+    lines += [f'.addr vt_exp{i:04x}' for i in range(len(veloce_records))]
+    for i, r in enumerate(veloce_records):
+        lines.append(f'vt_exp{i:04x}:')
+        lines.append(f'    .byte ${r["flags"]:02x}, ${r["ep"]:02x}, ${r["ea"]:02x}, ${r["ex"]:02x}, ${r["ey"]:02x}')
+        lines.append(f'    .byte "{r["name"]}", 0')
+    with open('spc_expected.inc', 'w') as f:
+        f.write('\n'.join(lines) + '\n')
+
+
 def close_spc_file():
     global file_num
 
@@ -953,6 +987,7 @@ def main():
     with open('tests.txt', 'w') as f:
         f.write('\n'.join(tests_txt) + '\n')
     close_spc_file()
+    write_veloce_expected()
 
 
 main()
diff --git a/spctest/spctest.asm b/spctest/spctest.asm
index 3db11e2..9262268 100644
--- a/spctest/spctest.asm
+++ b/spctest/spctest.asm
@@ -16,6 +16,16 @@
 ;   - CPU sets port1 = 2, SPC waits for it.
 ;   - SPC sets port1 = A, port2 = X, port3 = Y, port0 = 3
 ;   - SPC and CPU stop
+;
+; Veloce VELOCE-RESULT/1 patch (S-CPU side only; the S-SMP program is
+; unchanged): the S-CPU turns that protocol into CHECK/END lines on the
+; $21FE port. A program that reports success at test L passed every test
+; from the first unreported one up to L (the S-SMP runs them in order and
+; stops at the first failure), so each gets CHECK <n> PASS. A failure at test
+; N gets CHECK <N> FAIL with the first of P/A/X/Y that differs from the value
+; make_tests.py expects, then REG and END. If the test number stops changing
+; for 120 frames the S-SMP is treated as hung (CHECK FAIL + END), so a crash
+; still ends the transcript with a verdict.
 
 
 .segment "HEADER"
@@ -35,6 +45,23 @@
 spc_addr: .word 0
 spc_size: .word 0
 last_test_num: .word 0
+; Veloce reporter state
+vt_ptr: .res 3      ; long pointer to an expected-value record
+vt_next: .word 0    ; first test number without a CHECK line yet
+vt_pass: .word 0    ; CHECK ... PASS lines emitted
+vt_fail: .word 0    ; CHECK ... FAIL lines emitted
+vt_num: .word 0     ; test number whose record vt_load_rec loads
+vt_failnum: .word 0 ; test number the S-SMP failed on (or hung in)
+vt_tmp: .word 0
+vt_seen: .word 0    ; watchdog: last test number seen on ports 2/3
+vt_frames: .byte 0  ; watchdog: frames since it last changed
+vt_res_p: .byte 0   ; values the S-SMP reported for a failed test
+vt_res_a: .byte 0
+vt_res_x: .byte 0
+vt_res_y: .byte 0
+vt_expv: .byte 0    ; expected / observed byte of the first mismatch
+vt_obsv: .byte 0
+vt_digit: .byte 0   ; vt_dec16 scratch
 
 .segment "CODE"
 
@@ -69,12 +96,15 @@ main:
 	lda #$0F ; screen on
 	sta $2100
 
+	jsl vt_start_l
+
 	ldx #$ffff
 	stx last_test_num
 	load_and_run_spc spc0, spc0end
 	load_and_run_spc spc1, spc1end
 	load_and_run_spc spc2, spc2end
 
+	jsl vt_emit_end_l
 	ldx #txt_success
 	ldy #$32
 	jsr write_text
@@ -292,10 +322,29 @@ update_test_num:
 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 
 wait_result:
+	ldx #$ffff
+	stx vt_seen
+	stz vt_frames
 @wait1:
 	jsr update_test_num   ; This may not have effect while rendering, but we repeat it later anyway
 	lda $2140
-	beq @wait1
+	bne @done_waiting
+	; Veloce watchdog: 120 frames without a new test number = S-SMP hung.
+	ldx $2142
+	cpx vt_seen
+	beq @same
+	stx vt_seen
+	stz vt_frames
+	bra @wait1
+@same:
+	lda $4210  ; bit 7 is set once per vblank, NMI enabled or not
+	bpl @wait1
+	inc vt_frames
+	lda vt_frames
+	cmp #120
+	bne @wait1
+	jml vt_spc_hung
+@done_waiting:
 
 	jsr wait_for_vblank
 	jsr update_test_num
@@ -304,10 +353,14 @@ wait_result:
 	bne @failed
 
 	;  Tests succeeded
+	ldx $2142  ; last test of this program
+	jsl vt_pass_through_l
 	stz $2141  ; port1 = 0  (tell SPC to continue into IPL ROM)
 	rts
 
 @failed:
+	ldx $2142  ; failing test number (ports 2/3 keep it until port0 = 3)
+	stx vt_failnum
 	ldx #txt_fail
 	ldy #$32
 	jsr write_text
@@ -325,6 +378,7 @@ wait_result:
 	jsr write_text
 
 	lda $2141  ; PSW
+	sta vt_res_p
 	ldy #$105
 	jsr write_hex8
 
@@ -348,8 +402,288 @@ wait_result:
 	ldy #$E5
 	jsr write_hex8
 
+	lda $2141
+	sta vt_res_a
+	lda $2142
+	sta vt_res_x
+	lda $2143
+	sta vt_res_y
+	jsl vt_report_fail_l
+
+@end: bra @end
+
+;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
+; Veloce VELOCE-RESULT/1 reporter. Native mode, 8-bit A, 16-bit X/Y, D = 0,
+; DBR = 0. One CHECK line per test (id = test number in hex, as in
+; tests.txt), so END <pass>/<total> always equals the CHECK tally.
+; It lives in BANK2 (bank 0 is full with the first S-SMP program); the bank-0
+; code calls the *_l entry points with JSL. Data is read with long addressing
+; because DBR stays 0.
+
+.pushseg
+.segment "BANK2"
+
+; VELOCE-RESULT/1 emitters (tests/roms-src/include/snes), code lands here.
+.include "veloce-test.ca65.inc"
+
+vt_start_l:
+	jsr vt_start
+	rtl
+vt_emit_end_l:
+	jsr vt_emit_end
+	rtl
+vt_pass_through_l:
+	jsr vt_pass_through
+	rtl
+vt_report_fail_l:
+	jsr vt_report_fail
+	rtl
+
+vt_start:
+	VT_BEGIN "gilyon_spctest"
+	vt_putc_str "INFO tests="
+	ldx #VT_TOTAL_TESTS
+	jsr vt_dec16
+	vt_putc_str " source=gilyon/snes-tests@v1.4"
+	vt_putc_imm $0A
+	ldx #$0000
+	stx vt_next
+	stx vt_pass
+	stx vt_fail
+	rts
+
+; vt_ptr = expected-value record of test vt_num
+vt_load_rec:
+	rep #$20
+	.a16
+	lda vt_num
+	asl a
+	tax
+	lda f:vt_exp_ptrs,x
+	sta vt_ptr
+	sep #$20
+	.a8
+	lda #^vt_exp_ptrs
+	sta vt_ptr+2
+	rts
+
+vt_print_name:
+	ldy #$0005
+@loop:
+	lda [vt_ptr],y
+	beq @done
+	sta VT_PORT_DATA
+	iny
+	bra @loop
+@done:
+	rts
+
+; CHECK <n> PASS for every test from vt_next up to X (inclusive).
+vt_pass_through:
+	stx vt_tmp
+@loop:
+	rep #$20
+	.a16
+	lda vt_next
+	cmp vt_tmp
+	sep #$20
+	.a8
+	beq @emit
+	bcs @done  ; vt_next > X
+@emit:
+	jsr vt_emit_pass
+	bra @loop
+@done:
+	rts
+
+; CHECK <vt_next> PASS <name>, then advance vt_next
+vt_emit_pass:
+	ldx vt_next
+	stx vt_num
+	vt_putc_str "CHECK "
+	ldx vt_num
+	jsr vt_hex16
+	vt_putc_str " PASS "
+	jsr vt_load_rec
+	jsr vt_print_name
+	vt_putc_imm $0A
+	rep #$20
+	.a16
+	inc vt_pass
+	inc vt_next
+	sep #$20
+	.a8
+	rts
+
+; Compare record byte `off` with the reported `obs`; on mismatch print
+; " field=<label> exp=.. got=.." and jump to vt_print_mismatch. (The field is a
+; key=value token, so the CHECK name matches the PASS line.)
+.macro VT_SPC_CMP off, obs, label
+	.local ok
+	ldy #off
+	lda [vt_ptr],y
+	cmp obs
+	beq ok
+	sta vt_expv
+	lda obs
+	sta vt_obsv
+	vt_putc_str label
+	jmp vt_print_mismatch
+ok:
+.endmacro
+
+; CHECK <vt_num> FAIL for the test the S-SMP reported, then REG and END.
+vt_report_fail:
+	ldx vt_failnum
+	jsr vt_pass_below  ; (vt_emit_pass reuses vt_num)
+	ldx vt_failnum
+	stx vt_num
+	vt_putc_str "CHECK "
+	ldx vt_num
+	jsr vt_hex16
+	vt_putc_str " FAIL "
+	jsr vt_load_rec
+	jsr vt_print_name
+	; Same order as the S-SMP test code compares them.
+	VT_SPC_CMP 1, vt_res_p, " field=p"
+	VT_SPC_CMP 2, vt_res_a, " field=a"
+	VT_SPC_CMP 3, vt_res_x, " field=x"
+	VT_SPC_CMP 4, vt_res_y, " field=y"
+	; P/A/X/Y all as expected: the S-SMP failed a check it does not report
+	; back (SP, memory, or a hand-written check such as a branch target).
+	vt_putc_str " field=unreported"
+	vt_putc_imm $0A
+	jmp vt_report_regs
+
+; " exp=<vt_expv> got=<vt_obsv>" and newline, then the REG line
+vt_print_mismatch:
+	vt_putc_str " exp="
+	lda vt_expv
+	jsr vt_hex8
+	vt_putc_str " got="
+	lda vt_obsv
+	jsr vt_hex8
+	vt_putc_imm $0A
+vt_report_regs:
+	VT_REG_BEGIN
+	lda vt_res_a
+	VT_REG8 "a"
+	lda vt_res_x
+	VT_REG8 "x"
+	lda vt_res_y
+	VT_REG8 "y"
+	lda vt_res_p
+	VT_REG8 "p"
+	VT_REG_END
+	rep #$20
+	.a16
+	inc vt_fail
+	sep #$20
+	.a8
+	jmp vt_emit_end
+
+; S-SMP watchdog fired: the test on ports 2/3 never finished.
+vt_spc_hung:
+	ldx vt_seen
+	stx vt_failnum
+	jsr vt_pass_below
+	ldx vt_failnum
+	stx vt_num
+	vt_putc_str "CHECK "
+	ldx vt_num
+	jsr vt_hex16
+	vt_putc_str " FAIL "
+	jsr vt_load_rec
+	jsr vt_print_name
+	vt_putc_str " field=s-smp-hung"
+	vt_putc_imm $0A
+	rep #$20
+	.a16
+	inc vt_fail
+	sep #$20
+	.a8
+	jsr vt_emit_end
 @end: bra @end
 
+; PASS for every test from vt_next up to X-1 (none when X <= vt_next).
+vt_pass_below:
+	cpx vt_next
+	beq @none
+	bcc @none
+	dex
+	jmp vt_pass_through
+@none:
+	rts
+
+vt_emit_end:
+	vt_putc_str "END "
+	ldx vt_pass
+	jsr vt_dec16
+	vt_putc_imm '/'
+	rep #$20
+	.a16
+	lda vt_pass
+	clc
+	adc vt_fail
+	tax
+	sep #$20
+	.a8
+	jsr vt_dec16
+	vt_putc_imm $0A
+	rts
+
+; vt_dec16: print X (16-bit) in decimal without leading zeros.
+vt_dec16:
+	php
+	rep #$10
+	.i16
+	stx vt_tmp
+	ldy #$0000  ; nonzero once a digit has been printed
+	ldx #$0000  ; index into vt_pow10
+@digit:
+	sep #$20
+	.a8
+	lda #'0'
+	sta vt_digit
+	rep #$20
+	.a16
+@sub:
+	lda vt_tmp
+	cmp f:vt_pow10,x
+	bcc @emit
+	sbc f:vt_pow10,x
+	sta vt_tmp
+	sep #$20
+	.a8
+	inc vt_digit
+	rep #$20
+	.a16
+	bra @sub
+@emit:
+	sep #$20
+	.a8
+	lda vt_digit
+	cpy #$0000
+	bne @out
+	cmp #'0'
+	bne @out
+	cpx #$0008  ; always print the ones digit
+	bne @next
+@out:
+	sta VT_PORT_DATA
+	ldy #$0001
+@next:
+	inx
+	inx
+	cpx #$000A
+	bne @digit
+	plp
+	rts
+
+vt_pow10: .word 10000, 1000, 100, 10, 1
+
+.popseg
+
 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 
 
@@ -390,3 +724,7 @@ spc1end:
 spc2:
 	.incbin "spc_tests2.spc", $300
 spc2end:
+
+; Veloce: expected-value table from make_tests.py (BANK3, otherwise unused).
