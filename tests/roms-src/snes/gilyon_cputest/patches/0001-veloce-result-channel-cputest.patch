+def veloce_check_name(ins):
+    """CHECK-line name for a test: the instruction text, minus any assembler
+    comment, with whitespace collapsed (VELOCE-RESULT/1 names end at the first
+    key=value token, so a name must never contain '=')."""
+    name = ' '.join(ins.split(';', 1)[0].split())
+    assert '=' not in name and '"' not in name, name
+    return name
+
+
+# The expected-value records live in the otherwise unused LoROM banks 5-7.
+VELOCE_EXP_BANKS = ['BANK5', 'BANK6', 'BANK7']
+VELOCE_BANK_SIZE = 0x8000
+
+# Record layout (all words little-endian), mirrored by vt_name_offset and
+# vt_report_fail in main.asm:
+#   +0  flags: bit0 S checked, bit1 DBR checked, bit2 D checked,
+#              bit7 test has extra hand-written setup/checks
+#   +1  X  +3 Y  +5 P (bit 8 = E)  +7 A          (16-bit expected values)
+#   +9  [S word] [DBR byte] [D word]             (only when the flag is set)
+#   ..  memory check count n, then n x (24-bit address, expected byte)
+#   ..  NUL-terminated CHECK name
+def veloce_record_bytes(r):
+    flags = (1 if r['es'] is not None else 0) | (2 if r['edbr'] is not None else 0) | \
+            (4 if r['ed'] is not None else 0) | (0x80 if r['extra'] else 0)
+    out = [f'.byte ${flags:02x}',
+           f'.word ${r["ex"]:04x}, ${r["ey"]:04x}, ${r["ep"]:04x}, ${r["ea"]:04x}']
+    size = 9
+    if r['es'] is not None:
+        out.append(f'.word ${r["es"]:04x}')
+        size += 2
+    if r['edbr'] is not None:
+        out.append(f'.byte ${r["edbr"]:02x}')
+        size += 1
+    if r['ed'] is not None:
+        out.append(f'.word ${r["ed"]:04x}')
+        size += 2
+    out.append(f'.byte {len(r["mem"])}')
+    size += 1
+    for loc, val in r['mem']:
+        out.append(f'.faraddr ${loc:06x}')
+        out.append(f'.byte ${val:02x}')
+        size += 4
+    out.append(f'.byte "{r["name"]}", 0')
+    size += len(r['name']) + 1
+    return out, size
+
+
