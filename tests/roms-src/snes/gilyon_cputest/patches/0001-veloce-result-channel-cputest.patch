 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
+; Veloce VELOCE-RESULT/1 reporter. Every routine below expects native mode,
+; 8-bit A, 16-bit X/Y, D = 0 and DBR = 0 (what save_results leaves behind).
+; One CHECK line per test (id = the test number in hex, as in tests-full.txt),
+; so END <pass>/<total> always equals the CHECK tally.
+
+vt_start:
+	VT_BEGIN "gilyon_cputest"
+	vt_putc_str "INFO tests="
+	ldx #VT_TOTAL_TESTS
+	jsr vt_dec16
+.ifdef basic
+	vt_putc_str " variant=basic"
+.else
+	vt_putc_str " variant=full"
+.endif
+	vt_putc_str " source=gilyon/snes-tests@v1.4"
+	vt_putc_imm $0A
+	ldx #$0000
+	stx vt_pass
+	stx vt_fail
+	stz vt_cur_failed
+	stz vt_reason
+	rts
+
+; X = the test about to start. Emits PASS for test_num unless it already failed.
+vt_on_test_start:
+	php
+	phb
+	phx
+	rep #$08  ; binary mode for the hex printer
+	lda #$00
+	pha
+	plb
+	ldx test_num
+	cpx #$ffff
+	beq @first
+	lda vt_cur_failed
+	bne @first
+	jsr vt_emit_pass
+@first:
+	stz vt_cur_failed
+	stz vt_reason
+	plx
+	plb
+	plp
+	rts
+
+vt_emit_pass:
+	vt_putc_str "CHECK "
+	ldx test_num
+	jsr vt_hex16
+	vt_putc_str " PASS "
+	jsr vt_load_rec
+	jsr vt_print_name
+	vt_putc_imm $0A
+	rep #$20
+	.a16
+	inc vt_pass
+	sep #$20
+	.a8
+	rts
+
+vt_finish:
+	lda vt_cur_failed
+	bne @end
+	jsr vt_emit_pass
+	lda #$01
+	sta vt_cur_failed
+@end:
+	; fall through
+vt_emit_end:
+	vt_putc_str "END "
+	ldx vt_pass
+	jsr vt_dec16
+	vt_putc_imm '/'
+	rep #$20
+	.a16
+	lda vt_pass
+	clc
+	adc vt_fail
+	tax
+	sep #$20
+	.a8
+	jsr vt_dec16
+	vt_putc_imm $0A
+	rts
+
+; vt_ptr = expected-value record of test_num
+vt_load_rec:
+	rep #$20
+	.a16
+	lda test_num
+	asl a
+	clc
+	adc test_num
+	tax
+	sep #$20
+	.a8
+	lda f:vt_exp_ptrs,x
+	sta vt_ptr
+	lda f:vt_exp_ptrs+1,x
+	sta vt_ptr+1
+	lda f:vt_exp_ptrs+2,x
+	sta vt_ptr+2
+	rts
+
+; Y = offset of the memory-check count in the record at vt_ptr
+vt_mem_offset:
+	lda [vt_ptr]
+	ldy #$0009
+	lsr a
+	bcc :+
+	iny  ; S word
+	iny
+:	lsr a
+	bcc :+
+	iny  ; DBR byte
+:	lsr a
+	bcc :+
+	iny  ; D word
+	iny
+:	rts
+
+; Y = offset of the NUL-terminated name in the record at vt_ptr
+vt_name_offset:
+	jsr vt_mem_offset
+	sty vt_tmp
+	lda [vt_ptr],y
+	rep #$20
+	.a16
+	and #$00FF
+	asl a
+	asl a
+	sec  ; +1 for the count byte itself
+	adc vt_tmp
+	tay
+	sep #$20
+	.a8
+	rts
+
+vt_print_name:
+	jsr vt_name_offset
+@loop:
+	lda [vt_ptr],y
+	beq @done
+	sta VT_PORT_DATA
+	iny
+	bra @loop
+@done:
+	rts
+
+; " exp=<vt_tmp> got=<vt_tmp2>" as 16-bit hex, then newline
+vt_print_expgot16:
+	vt_putc_str " exp="
+	ldx vt_tmp
+	jsr vt_hex16
+	vt_putc_str " got="
+	ldx vt_tmp2
+	jsr vt_hex16
+	vt_putc_imm $0A
+	rts
+
+; Compare the 16-bit record field at offset `off` with `var`; on mismatch
+; print " field=<label> exp=.. got=..", end the line and jump to vt_report_regs.
+; (The field is a key=value token, so the CHECK name matches the PASS line.)
+.macro VT_CHECK16 off, var, label
+	.local ok
+	ldy #off
+	rep #$20
+	.a16
+	lda [vt_ptr],y
+	sta vt_tmp
+	lda var
+	sta vt_tmp2
+	cmp vt_tmp
+	sep #$20
+	.a8
+	beq ok
+	vt_putc_str label
+	jsr vt_print_expgot16
+	jmp vt_report_regs
+ok:
+.endmacro
+
+vt_report_fail:
+	vt_putc_str "CHECK "
+	ldx test_num
+	jsr vt_hex16
+	vt_putc_str " FAIL "
+	jsr vt_load_rec
+	jsr vt_print_name
+	lda vt_reason
+	bne :+
+	jmp @compare
+:
+	; No REG line: the test never reached save_results, so result_* still
+	; hold the previous test's registers.
+	vt_putc_str " field=unexpected-brk-cop"
+	vt_putc_imm $0A
+	jmp vt_count_fail
+@compare:
+	; Same order as the generated test code compares them.
+	VT_CHECK16 1, result_x, " field=x"
+	VT_CHECK16 3, result_y, " field=y"
+	VT_CHECK16 5, result_p, " field=e:p"
+	VT_CHECK16 7, result_a, " field=a"
+	; Optional S / DBR / D fields, then the memory checks.
+	lda [vt_ptr]
+	sta vt_flags
+	ldx #$0009
+	stx vt_off
+	lda vt_flags
+	and #$01
+	bne :+
+	jmp @no_s
+:
+	ldy vt_off
+	rep #$20
+	.a16
+	lda [vt_ptr],y
+	sta vt_tmp
+	lda result_s
+	sta vt_tmp2
+	cmp vt_tmp
+	sep #$20
+	.a8
+	beq :+
+	vt_putc_str " field=s"
+	jsr vt_print_expgot16
+	jmp vt_report_regs
+:	ldx vt_off
+	inx
+	inx
+	stx vt_off
+@no_s:
+	lda vt_flags
+	and #$02
+	bne :+
+	jmp @no_dbr
+:
+	ldy vt_off
+	lda [vt_ptr],y
+	sta vt_tmp
+	lda result_dbr
+	sta vt_tmp2
+	cmp vt_tmp
+	beq :+
+	vt_putc_str " field=dbr"
+	jsr vt_print_expgot8
+	vt_putc_imm $0A
+	jmp vt_report_regs
+:	ldx vt_off
+	inx
+	stx vt_off
+@no_dbr:
+	lda vt_flags
+	and #$04
+	bne :+
+	jmp @no_d
+:
+	ldy vt_off
+	rep #$20
+	.a16
+	lda [vt_ptr],y
+	sta vt_tmp
+	lda result_d
+	sta vt_tmp2
+	cmp vt_tmp
+	sep #$20
+	.a8
+	beq :+
+	vt_putc_str " field=d"
+	jsr vt_print_expgot16
+	jmp vt_report_regs
+:	ldx vt_off
+	inx
+	inx
+	stx vt_off
+@no_d:
+	ldy vt_off
+	lda [vt_ptr],y  ; memory check count
+	sta vt_cnt
+	iny
+@mem_loop:
+	lda vt_cnt
+	bne :+
+	jmp @no_mismatch
+:
+	lda [vt_ptr],y
+	sta vt_mptr
+	iny
+	lda [vt_ptr],y
+	sta vt_mptr+1
+	iny
+	lda [vt_ptr],y
+	sta vt_mptr+2
+	iny
+	lda [vt_ptr],y
+	sta vt_tmp
+	iny
+	lda [vt_mptr]
+	sta vt_tmp2
+	cmp vt_tmp
+	bne @mem_bad
+	dec vt_cnt
+	bra @mem_loop
+@mem_bad:
+	vt_putc_str " field=mem"
+	jsr vt_print_expgot8
+	vt_putc_str " at="
+	lda vt_mptr+2
+	jsr vt_hex8
+	ldx vt_mptr
+	jsr vt_hex16
+	vt_putc_imm $0A
+	jmp vt_report_regs
+@no_mismatch:
+	; Every tabulated value matches: the test failed one of its hand-written
+	; checks (e.g. a branch or jump that landed on the wrong path).
+	vt_putc_str " field=additional-check"
+	vt_putc_imm $0A
+	jmp vt_report_regs
+
+; " exp=<vt_tmp> got=<vt_tmp2>" as 8-bit hex (no newline)
+vt_print_expgot8:
+	vt_putc_str " exp="
+	lda vt_tmp
+	jsr vt_hex8
+	vt_putc_str " got="
+	lda vt_tmp2
+	jsr vt_hex8
+	rts
+
+; CHECK line for "Invalid test order": vt_tmp2 = the test that started,
+; test_num + 1 = the one that should have. Ends the transcript.
+vt_report_order:
+	vt_putc_str "CHECK "
+	ldx vt_tmp2
+	jsr vt_hex16
+	vt_putc_str " FAIL invalid test order (errant jump)"
+	rep #$20
+	.a16
+	lda test_num
+	inc a
+	sta vt_tmp
+	sep #$20
+	.a8
+	jsr vt_print_expgot16
+	rep #$20
+	.a16
+	inc vt_fail
+	sep #$20
+	.a8
+	jmp vt_emit_end
+
+; BRK/COP handler target installed by init_mem
+vt_brk_cop:
+	sei
+	clc
+	xce
+	sep #$20
+	.a8
+	lda #$01
+	sta f:vt_reason
+	jml fail
+
+vt_report_regs:
+	VT_REG_BEGIN
+	ldx result_a
+	VT_REG16 "a"
+	ldx result_x
+	VT_REG16 "x"
+	ldx result_y
+	VT_REG16 "y"
+	lda result_p
+	VT_REG8 "p"
+	lda result_p+1
+	VT_REG8 "e"
+	ldx result_s
+	VT_REG16 "s"
+	ldx result_d
+	VT_REG16 "d"
+	lda result_dbr
+	VT_REG8 "dbr"
+	VT_REG_END
+vt_count_fail:
+	rep #$20
+	.a16
+	inc vt_fail
+	sep #$20
+	.a8
+	lda #$01
+	sta vt_cur_failed
+	rts
+
+; vt_dec16: print X (16-bit) in decimal without leading zeros.
+vt_dec16:
+	php
+	rep #$10
+	.i16
+	stx vt_tmp
+	ldy #$0000  ; nonzero once a digit has been printed
+	ldx #$0000  ; index into vt_pow10
+@digit:
+	sep #$20
+	.a8
+	lda #'0'
+	sta vt_cnt
+	rep #$20
+	.a16
+@sub:
+	lda vt_tmp
+	cmp vt_pow10,x
+	bcc @emit
+	sbc vt_pow10,x
+	sta vt_tmp
+	sep #$20
+	.a8
+	inc vt_cnt
+	rep #$20
+	.a16
+	bra @sub
+@emit:
+	sep #$20
+	.a8
+	lda vt_cnt
+	cpy #$0000
+	bne @out
+	cmp #'0'
+	bne @out
+	cpx #$0008  ; always print the ones digit
+	bne @next
+@out:
+	sta VT_PORT_DATA
+	ldy #$0001
+@next:
+	inx
+	inx
+	cpx #$000A
+	bne @digit
+	plp
+	rts
+
+vt_pow10: .word 10000, 1000, 100, 10, 1
