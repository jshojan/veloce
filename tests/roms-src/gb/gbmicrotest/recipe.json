{
  "console": "gb",
  "suite": "gbmicrotest",
  "description": "aappleby/GBMicrotest: tiny, single-purpose PPU/timer/OAM/HDMA microtests. Assembled with wla-gb via the upstream build.sh (produces bin/*.gb).",
  "license": "No licence file at the pinned SHA and none named in its README; treated as patch-only (recipe + PROVENANCE.md committed, never a ROM)",
  "repo": {
    "url": "https://github.com/aappleby/GBMicrotest.git",
    "sha": "f3b55497c1d1202c784b8201dafc888c838b7302"
  },
  "toolchain_stage": "wla-dx",
  "golden_gate": false,
  "golden_gate_reason": "Upstream's checked-in bin/*.gb (its build.sh's own output dir, committed at this pinned SHA) IS what build.py's shipped-then-delete-then-rebuild gate compares against, and 509/513 pass. golden_gate stays false because the other 4 (line_153_lyc_a/b/c, ppu_spritex_vs_scx) are stale: upstream's committed binary predates a later source change at the same SHA's tree state, so a fresh rebuild of the current .s legitimately differs from what's checked in -- see rom_manifest.json's per-file golden_gate.{golden_sha256,rebuilt_sha256}. A true gate would incorrectly block on 4 files with pre-existing upstream drift unrelated to Veloce. Independently verified against the c-sp/gameboy-test-roms v7.0 release bundle vendored locally at cores/gb/tests/roms/gbmicrotest/: all 513 rebuilt ROMs are byte-identical (sha256) to that bundle, including the 4 that differ from upstream's own stale committed copy -- c-sp's release rebuilt them fresh too.",
  "rom_variant": "upstream",
  "build": {
    "workdir": ".",
    "commands": [
      "chmod +x build.sh",
      "./build.sh"
