{
  "console": "nes",
  "suite": "ppu_vbl_nmi",
  "description": "Blargg ppu_vbl_nmi: VBlank flag and NMI timing. ppu_vbl_nmi.nes combined ROM out of scope, same reason as instr_test-v5.",
  "license": "public domain / freely redistributable (Shay Green (blargg)'s test framework); see upstream ppu_vbl_nmi/source/readme.txt",
  "repo": {
    "url": "https://github.com/christopherpow/nes-test-roms.git",
    "sha": "95d8f621ae55cee0d09b91519a8989ae0e64753b"
  },
  "toolchain_stage": "cc65",
  "golden_gate": false,
  "golden_gate_reason": "Same issue tests/roms-src/nes/cpu_dummy_reads/PROVENANCE.md documents: the shared common/delay.s countdown idiom ('adc #-1' / 'sbc #-1') needs ca65's '--feature force_range' to assemble at all (no ca65 in cc65's git history accepts a bare out-of-range immediate byte). With that feature on, the rebuilt ROM is the same size (40976 bytes) as upstream's shipped copy but differs at 386 byte(s), first divergence at file offset 0x6208 (25112) (inside the CHARS-adjacent PRG bank, same region cpu_dummy_reads diverges in) -- consistent with cpu_dummy_reads's unconfirmed theory that '--feature force_range' changes which of shell.inc's jeq/jne/jpl/jmi longbranch.mac macros resolve short vs. long somewhere upstream in the same object file. Verified behaviourally instead (this suite's own NES-2 report has the double-build determinism check): two independent rebuilds of the unmodified source are byte-identical to each other, so the pipeline is reproducible even though it doesn't reproduce this specific pre-existing binary. See cpu_dummy_reads/PROVENANCE.md for the full investigation; not repeated per suite.",
  "rom_variant": "upstream",
  "build": {
    "workdir": "ppu_vbl_nmi/source",
    "commands": [
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 01_vbl_basics.o 01-vbl_basics.s",
      "ld65 -C nes.cfg 01_vbl_basics.o -o ../rom_singles/01-vbl_basics.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 02_vbl_set_time.o 02-vbl_set_time.s",
      "ld65 -C nes.cfg 02_vbl_set_time.o -o ../rom_singles/02-vbl_set_time.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 03_vbl_clear_time.o 03-vbl_clear_time.s",
      "ld65 -C nes.cfg 03_vbl_clear_time.o -o ../rom_singles/03-vbl_clear_time.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 04_nmi_control.o 04-nmi_control.s",
      "ld65 -C nes.cfg 04_nmi_control.o -o ../rom_singles/04-nmi_control.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 05_nmi_timing.o 05-nmi_timing.s",
      "ld65 -C nes.cfg 05_nmi_timing.o -o ../rom_singles/05-nmi_timing.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 06_suppression.o 06-suppression.s",
      "ld65 -C nes.cfg 06_suppression.o -o ../rom_singles/06-suppression.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 07_nmi_on_timing.o 07-nmi_on_timing.s",
      "ld65 -C nes.cfg 07_nmi_on_timing.o -o ../rom_singles/07-nmi_on_timing.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 08_nmi_off_timing.o 08-nmi_off_timing.s",
      "ld65 -C nes.cfg 08_nmi_off_timing.o -o ../rom_singles/08-nmi_off_timing.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 09_even_odd_frames.o 09-even_odd_frames.s",
      "ld65 -C nes.cfg 09_even_odd_frames.o -o ../rom_singles/09-even_odd_frames.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 10_even_odd_timing.o 10-even_odd_timing.s",
      "ld65 -C nes.cfg 10_even_odd_timing.o -o ../rom_singles/10-even_odd_timing.nes"
    ],
    "artifacts": {
      "ppu_vbl_nmi/rom_singles/01-vbl_basics.nes": "01-vbl_basics.nes",
      "ppu_vbl_nmi/rom_singles/02-vbl_set_time.nes": "02-vbl_set_time.nes",
      "ppu_vbl_nmi/rom_singles/03-vbl_clear_time.nes": "03-vbl_clear_time.nes",
      "ppu_vbl_nmi/rom_singles/04-nmi_control.nes": "04-nmi_control.nes",
      "ppu_vbl_nmi/rom_singles/05-nmi_timing.nes": "05-nmi_timing.nes",
      "ppu_vbl_nmi/rom_singles/06-suppression.nes": "06-suppression.nes",
      "ppu_vbl_nmi/rom_singles/07-nmi_on_timing.nes": "07-nmi_on_timing.nes",
      "ppu_vbl_nmi/rom_singles/08-nmi_off_timing.nes": "08-nmi_off_timing.nes",
      "ppu_vbl_nmi/rom_singles/09-even_odd_frames.nes": "09-even_odd_frames.nes",
      "ppu_vbl_nmi/rom_singles/10-even_odd_timing.nes": "10-even_odd_timing.nes"
    }
  }
}
