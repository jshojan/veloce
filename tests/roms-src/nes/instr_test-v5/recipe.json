{
  "console": "nes",
  "suite": "instr_test-v5",
  "description": "Blargg instr_test-v5: official 6502 opcode result checksums (16 rom_singles). official_only.nes and all_instrs.nes are combined multi-test ROMs the suite's own readme.txt says are built by tooling 'not included' -- out of scope for this golden gate.",
  "license": "public domain / freely redistributable (Shay Green (blargg)'s test framework); see upstream instr_test-v5/source/readme.txt",
  "repo": {
    "url": "https://github.com/christopherpow/nes-test-roms.git",
    "sha": "95d8f621ae55cee0d09b91519a8989ae0e64753b"
  },
  "toolchain_stage": "cc65",
  "golden_gate": false,
  "golden_gate_reason": "Same issue tests/roms-src/nes/cpu_dummy_reads/PROVENANCE.md documents: the shared common/delay.s countdown idiom ('adc #-1' / 'sbc #-1') needs ca65's '--feature force_range' to assemble at all (no ca65 in cc65's git history accepts a bare out-of-range immediate byte). With that feature on, the rebuilt ROM is the same size (40976 bytes) as upstream's shipped copy but differs at 337 byte(s), first divergence at file offset 0x6220 (25121) (inside the CHARS-adjacent PRG bank, same region cpu_dummy_reads diverges in) -- consistent with cpu_dummy_reads's unconfirmed theory that '--feature force_range' changes which of shell.inc's jeq/jne/jpl/jmi longbranch.mac macros resolve short vs. long somewhere upstream in the same object file. Verified behaviourally instead (this suite's own NES-2 report has the double-build determinism check): two independent rebuilds of the unmodified source are byte-identical to each other, so the pipeline is reproducible even though it doesn't reproduce this specific pre-existing binary. See cpu_dummy_reads/PROVENANCE.md for the full investigation; not repeated per suite.",
  "rom_variant": "upstream",
  "build": {
    "workdir": "instr_test-v5/source",
    "commands": [
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 01_basics.o 01-basics.s",
      "ld65 -C nes.cfg 01_basics.o -o ../rom_singles/01-basics.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 02_implied.o 02-implied.s",
      "ld65 -C nes.cfg 02_implied.o -o ../rom_singles/02-implied.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 03_immediate.o 03-immediate.s",
      "ld65 -C nes.cfg 03_immediate.o -o ../rom_singles/03-immediate.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 04_zero_page.o 04-zero_page.s",
      "ld65 -C nes.cfg 04_zero_page.o -o ../rom_singles/04-zero_page.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 05_zp_xy.o 05-zp_xy.s",
      "ld65 -C nes.cfg 05_zp_xy.o -o ../rom_singles/05-zp_xy.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 06_absolute.o 06-absolute.s",
      "ld65 -C nes.cfg 06_absolute.o -o ../rom_singles/06-absolute.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 07_abs_xy.o 07-abs_xy.s",
      "ld65 -C nes.cfg 07_abs_xy.o -o ../rom_singles/07-abs_xy.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 08_ind_x.o 08-ind_x.s",
      "ld65 -C nes.cfg 08_ind_x.o -o ../rom_singles/08-ind_x.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 09_ind_y.o 09-ind_y.s",
      "ld65 -C nes.cfg 09_ind_y.o -o ../rom_singles/09-ind_y.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 10_branches.o 10-branches.s",
      "ld65 -C nes.cfg 10_branches.o -o ../rom_singles/10-branches.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 11_stack.o 11-stack.s",
      "ld65 -C nes.cfg 11_stack.o -o ../rom_singles/11-stack.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 12_jmp_jsr.o 12-jmp_jsr.s",
      "ld65 -C nes.cfg 12_jmp_jsr.o -o ../rom_singles/12-jmp_jsr.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 13_rts.o 13-rts.s",
      "ld65 -C nes.cfg 13_rts.o -o ../rom_singles/13-rts.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 14_rti.o 14-rti.s",
      "ld65 -C nes.cfg 14_rti.o -o ../rom_singles/14-rti.nes",
