      "ld65 -C nes.cfg 15_brk.o -o ../rom_singles/15-brk.nes",
      "ca65 --feature force_range --smart -t nes -I common -I /opt/rom-toolchain/cc65-asminc -o 16_special.o 16-special.s",
      "ld65 -C nes.cfg 16_special.o -o ../rom_singles/16-special.nes"
    ],
    "artifacts": {
      "instr_test-v5/rom_singles/01-basics.nes": "01-basics.nes",
      "instr_test-v5/rom_singles/02-implied.nes": "02-implied.nes",
      "instr_test-v5/rom_singles/03-immediate.nes": "03-immediate.nes",
      "instr_test-v5/rom_singles/04-zero_page.nes": "04-zero_page.nes",
      "instr_test-v5/rom_singles/05-zp_xy.nes": "05-zp_xy.nes",
