    "haltcnt": {
      "test_haltcnt_direct": {
        "expect": "identical"
      },
      "test_haltcnt_cpuset": {
        "expect": "reviewed",
        "why": "Before the window: `sub sp, sp, #8` is scheduled earlier in the rebuilt code, but in both builds it runs before TM0 is started (`strh lr, [r4, #2]`); from TM0 start to the TM0CNT_L read the sequences are identical.",
        "diff": [
          [
            "delete",
            [
              "sub sp, sp, #8"
            ],
            []
          ],
          [
            "insert",
            [],
            [
              "sub sp, sp, #8"
            ]
          ]
        ]
      },
      "haltcnt_cpuset_dma_time": {
        "expect": "reviewed",
        "why": "Pinned by the Veloce patch to the shipped sequence (see PROVENANCE.md). Everything up to and including the TM0CNT_L read (`ldrh r2, [r4]`) is identical; after it the shipped function goes on to call test_expect(), the pinned one returns the value (`mov r0, r2`) to a C wrapper that calls it.",
        "diff": [
          [
            "replace",
            [
              "mov r0, r2"
            ],
            [
              "ldr r1, [pc, #X]",
              "ldr r0, [pc, #X]",
              "bl T"
            ]
          ]
        ]
      },
      "test_haltcnt_timing_iwram": {
        "expect": "reviewed",
        "why": "Before the window: the shipped -O0 code zero-extends REG_IF with `lsl/lsr #16` inside the `while ((REG_IF & IRQ_TIMER0) == 0);` poll. The poll ends before TM0 is reset and restarted, which is where the measured interval starts; from there to the TM0CNT_L read the sequences are identical.",
        "diff": [
          [
            "insert",
            [],
            [
              "lsl r3, r3, #16",
              "lsr r3, r3, #16"
            ]
          ]
        ]
      },
      "test_haltcnt_timing_rom": {
        "expect": "reviewed",
        "why": "Same as test_haltcnt_timing_iwram (identical -O0 body, executed from ROM): the extra shipped `lsl/lsr #16` is in the IF poll before TM0 is restarted.",
        "diff": [
          [
            "insert",
            [],
            [
              "lsl r3, r3, #16",
              "lsr r3, r3, #16"
            ]
          ]
        ]
      },
