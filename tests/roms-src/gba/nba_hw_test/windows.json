    "irq/irq-delay": {
      "irq_handler": {
        "expect": "reviewed",
        "why": "Register allocation only, plus the zero test of the byte just loaded by ldrb: rebuilt `cmp r2, #0`, shipped `ands r3, r3, #255`. Both are one single-cycle ARM data-processing instruction setting Z, so the instruction count, classes and memory accesses from IRQ dispatch to the TM0CNT_L read (`ldrh ip, [ip]`, identical) are unchanged.",
        "diff": [
          [
            "replace",
            [
              "ldr r3, [pc, #X]",
              "ldrb r2, [r3]",
              "cmp r2, #0"
            ],
            [
              "ldr r2, [pc, #X]",
              "ldrb r3, [r2]",
              "ands r3, r3, #255"
            ]
          ],
          [
            "replace",
            [
              "strb r0, [r3]",
              "strh ip, [r3, #2]",
              "str r2, [r1, #256]"
            ],
            [
              "strb r0, [r2]",
              "strh ip, [r2, #2]",
              "str r3, [r1, #256]"
            ]
          ]
        ]
      },
      "test_irq_time_iwram": {
        "expect": "identical"
      },
      "test_irq_time_ewram": {
        "expect": "identical"
      },
