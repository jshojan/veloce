diff --git a/lib/source/test.c b/lib/source/test.c
index b7bc1d6..6fa64b9 100644
--- a/lib/source/test.c
+++ b/lib/source/test.c
@@ -1,11 +1,99 @@
 #include <gba_systemcalls.h>
 #include <stdio.h>
+#include <string.h>
 
 #include "test.h"
+#include "../veloce/veloce_test.h"
 
 static int test_count = 0;
 static int test_pass_count = 0;
 
+// Veloce: VELOCE-RESULT/1 tally. Unlike test_count/test_pass_count it is
+// never cleared by test_reset(), so a ROM that shows several result pages
+// (ppu/status-irq-dma) still reports one cumulative END line.
+static int vt_count = 0;
+static int vt_pass_count = 0;
+static int vt_group_count = 0;
+static bool vt_manual_end = false;
+static bool vt_ended = false;
+static const char* vt_group = NULL;
+
+// Veloce: runs from __libc_init_array before main(), i.e. before the ROM's
+// consoleDemoInit()/ui_init(), so no test's main.c needs to change for it.
+// mgba_console_open() performs the 0x4FFF780 handshake and points stdout/
+// stderr at the debug registers; consoleDemoInit() afterwards rebinds both
+// to the on-screen console, so the human-readable text stays on screen and
+// only the lines below (one mgba_printf() each) reach the result channel.
+// The suite id is the ROM header title gbafix wrote (the make target, cut
+// to 12 characters).
+__attribute__((constructor)) static void test_veloce_open() {
+  char title[13];
+  char suite[32];
+
+  memcpy(title, (const void*)0x080000A0, 12);
+  title[12] = '\0';
+
+  mgba_console_open();
+  snprintf(suite, sizeof(suite), "nba-hw-test/%s", title);
+  vt_begin("gba", suite);
+}
+
+// One CHECK line per expectation. A token containing '=' would end the
+// check name early (docs/testing/VELOCE-RESULT.md section 2), and several
+// nba names do contain one ("HBLANK=0"), so '=' is written as ':'.
+static void test_veloce_check(
+  const char* name,
+  bool pass,
+  u32 expected_lo,
+  u32 expected_hi,
+  u32 actual
+) {
+  char id[12];
+  char label[64];
+  size_t i;
+
+  vt_count++;
+  snprintf(id, sizeof(id), "%d", vt_count);
+
+  if (vt_group) {
+    snprintf(label, sizeof(label), "%s %s", vt_group, name);
+  } else {
+    snprintf(label, sizeof(label), "%s", name);
+  }
+  for (i = 0; label[i] != '\0'; i++) {
+    if (label[i] == '=') label[i] = ':';
+  }
+
+  if (pass) {
+    vt_pass_count++;
+    vt_pass(id, label);
+  } else if (expected_lo == expected_hi) {
+    vt_fail(id, label, (unsigned int)expected_lo, (unsigned int)actual);
+  } else {
+    mgba_printf(MGBA_LOG_INFO, "CHECK %s FAIL %s exp=%08x got=%08x exp_max=%08x",
+      id, label, (unsigned int)expected_lo, (unsigned int)actual, (unsigned int)expected_hi);
+  }
+}
+
+void test_veloce_group(const char* name) {
+  char id[12];
+
+  vt_group = name;
+  vt_group_count++;
+  snprintf(id, sizeof(id), "%d", vt_group_count);
+  vt_test(id, name);
+}
+
+void test_veloce_manual_end() {
+  vt_manual_end = true;
+}
+
+void test_veloce_end() {
+  if (vt_ended) return;
+  vt_ended = true;
+  vt_end(vt_pass_count, vt_count);
+}
+
 IWRAM_CODE void test_reset() {
   test_count = 0;
   test_pass_count = 0;
@@ -30,6 +118,7 @@ IWRAM_CODE void test_expect_range(
     printf("FAIL %ld\n  expected: %ld\n", actual, expected_lo);
   }
 
+  test_veloce_check(name, pass, expected_lo, expected_hi, actual);
   test_count++;
 }
 
@@ -55,6 +144,7 @@ IWRAM_CODE void test_expect_hex(
     printf("FAIL 0x%lx\n  expected: 0x%lx\n", actual, expected);
   }
 
+  test_veloce_check(name, expected == actual, expected, expected, actual);
   test_count++;
 }
 
@@ -64,6 +154,10 @@ IWRAM_CODE void test_print_metrics() {
   } else {
     printf("\npass:  %d\ntotal: %d\n", test_pass_count, test_count);
   }
+
+  if (!vt_manual_end) {
+    test_veloce_end();
+  }
 }
 
